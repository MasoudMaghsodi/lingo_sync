# Supabase Configuration (from your Supabase Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key
# Live Voice WebSocket Model (defaults to models/gemini-3.8-live)
GEMINI_LIVE_MODEL=models/gemini-3.8-live

# Security Secret Key shared between yt-api and ai-express
YT_PROXY_SECRET_KEY=generate_a_random_32_character_string_here

# Internal / External Host for YouTube transcript proxy
# When using docker-compose, this can be "yt-api"
YT_PROXY_HOST=yt-api
